import tkinter as tk
from tkinter import messagebox, ttk
import json
import os
from datetime import datetime

DATA_FILE = "cobros.json"

def cargar_datos():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, "r") as f:
            return json.load(f)
    return {}

def guardar_datos(data):
    with open(DATA_FILE, "w") as f:
        json.dump(data, f, indent=4)

class AppCobros:
    def __init__(self, root):
        self.root = root
        self.root.title("App de Cobros")
        self.data = cargar_datos()
        
        self.crear_widgets()

    def crear_widgets(self):
        # Cliente
        self.label_cliente = tk.Label(self.root, text="Cliente:")
        self.label_cliente.grid(row=0, column=0, padx=5, pady=5, sticky="w")
        self.entry_cliente = tk.Entry(self.root)
        self.entry_cliente.grid(row=0, column=1, padx=5, pady=5)

        self.btn_registrar = tk.Button(self.root, text="Registrar Cliente", command=self.registrar_cliente)
        self.btn_registrar.grid(row=0, column=2, padx=5, pady=5)

        # Cliente seleccionado
        self.label_select = tk.Label(self.root, text="Seleccionar Cliente:")
        self.label_select.grid(row=1, column=0, padx=5, pady=5, sticky="w")
        self.cliente_var = tk.StringVar()
        self.combo_clientes = ttk.Combobox(self.root, textvariable=self.cliente_var, values=list(self.data.keys()))
        self.combo_clientes.grid(row=1, column=1, padx=5, pady=5)
        self.combo_clientes.bind("<<ComboboxSelected>>", lambda e: self.mostrar_historial())

        # Monto y descripción
        self.label_monto = tk.Label(self.root, text="Monto:")
        self.label_monto.grid(row=2, column=0, padx=5, pady=5, sticky="w")
        self.entry_monto = tk.Entry(self.root)
        self.entry_monto.grid(row=2, column=1, padx=5, pady=5)

        self.label_desc = tk.Label(self.root, text="Descripción:")
        self.label_desc.grid(row=3, column=0, padx=5, pady=5, sticky="w")
        self.entry_desc = tk.Entry(self.root)
        self.entry_desc.grid(row=3, column=1, padx=5, pady=5)

        self.btn_agregar = tk.Button(self.root, text="Agregar Cobro", command=self.agregar_cobro)
        self.btn_agregar.grid(row=4, column=1, padx=5, pady=5)

        # Historial
        self.label_hist = tk.Label(self.root, text="Historial de Cobros:")
        self.label_hist.grid(row=5, column=0, columnspan=3, sticky="w", padx=5)
        self.text_historial = tk.Text(self.root, width=50, height=10, state='disabled')
        self.text_historial.grid(row=6, column=0, columnspan=3, padx=5, pady=5)

        # Total
        self.btn_total = tk.Button(self.root, text="Mostrar Total Cobrado", command=self.mostrar_total)
        self.btn_total.grid(row=7, column=0, padx=5, pady=5)
        self.label_total = tk.Label(self.root, text="Total: $0.00")
        self.label_total.grid(row=7, column=1, padx=5, pady=5, sticky="w")

    def registrar_cliente(self):
        nombre = self.entry_cliente.get().strip()
        if nombre:
            if nombre in self.data:
                messagebox.showinfo("Info", "El cliente ya existe.")
            else:
                self.data[nombre] = []
                self.combo_clientes["values"] = list(self.data.keys())
                guardar_datos(self.data)
                messagebox.showinfo("Éxito", "Cliente registrado.")
                self.entry_cliente.delete(0, tk.END)
        else:
            messagebox.showwarning("Atención", "Ingresa un nombre válido.")

    def agregar_cobro(self):
        cliente = self.cliente_var.get()
        try:
            monto = float(self.entry_monto.get())
        except ValueError:
            messagebox.showwarning("Error", "Monto inválido.")
            return

        descripcion = self.entry_desc.get().strip()

        if cliente in self.data and monto > 0:
            fecha = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            self.data[cliente].append({"monto": monto, "descripcion": descripcion, "fecha": fecha})
            guardar_datos(self.data)
            self.entry_monto.delete(0, tk.END)
            self.entry_desc.delete(0, tk.END)
            self.mostrar_historial()
            messagebox.showinfo("Éxito", "Cobro agregado.")
        else:
            messagebox.showwarning("Error", "Selecciona un cliente y un monto válido.")

    def mostrar_historial(self):
        cliente = self.cliente_var.get()
        self.text_historial.config(state='normal')
        self.text_historial.delete(1.0, tk.END)
        if cliente in self.data:
            for cobro in self.data[cliente]:
                self.text_historial.insert(tk.END, f"{cobro['fecha']} - ${cobro['monto']} - {cobro['descripcion']}\n")
        self.text_historial.config(state='disabled')

    def mostrar_total(self):
        total = sum(cobro["monto"] for cobros in self.data.values() for cobro in cobros)
        self.label_total.config(text=f"Total: ${total:.2f}")

if __name__ == "__main__":
    root = tk.Tk()
    app = AppCobros(root)
    root.mainloop()
